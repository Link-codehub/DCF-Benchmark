      "evidence": "/app/output.xlsx",
      "condition": "file_exists",
      "weight": 8,
      "method": "rule",
      "severity": "critical",
      "check": {
        "kind": "file_exists"
      }
    },
    {
      "id": "01-KEYS",
      "category": "交付与来源完整性",
