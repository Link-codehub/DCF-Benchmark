      "score": "0|1",
      "evidence": "string"
    }
  },
  "judge_input": {
    "public_instruction": "instruction.md",
    "candidate": "/app/output.xlsx",
    "rubric_item": "one item or related group",
    "expected_numbers": "never sent"
