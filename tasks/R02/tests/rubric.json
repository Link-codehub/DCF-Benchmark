  "category_weights": {
    "交付与来源完整性": 8,
    "历史与会计口径": 10,
    "经营预测": 18,
    "DCF与估值桥": 24,
    "公式与模型工程": 20,
    "表达与专业可用性": 4
  },
  "score_range": [
    0,
    100
  ],
  "rule_score_range": [
    0,
    80
  ],
  "judge_calls": {
    "llm": "每次仅一个原子项",
    "agent": "每次同一题一个相关小组",
